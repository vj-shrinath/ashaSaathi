PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# ── Anthropic Claude AI ────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Sarvam AI (STT + TTS for Hindi) ──────────────────────────────────────────
# Get from: https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key

# ── Meta WhatsApp Business API ────────────────────────────────────────────────
# Create at: https://developers.facebook.com/ → WhatsApp → Configuration
META_VERIFY_TOKEN=your_unique_random_secret_here
META_ACCESS_TOKEN=your_meta_access_token
META_PHONE_NUMBER_ID=your_meta_phone_number_id

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Download from: Firebase Console → Project Settings → Service Accounts → Generate Key
# Save the file as backend/serviceAccountKey.json
GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccountKey.json
